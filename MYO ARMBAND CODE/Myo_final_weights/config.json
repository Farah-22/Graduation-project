{
    "model_architecture": "Metric_ContinualNet",
    "embedding_dim": 32,
    "num_sensors": 8,
    "window_size": 200,
    "sampling_rate": 200.0,
    "base_classes": [
        0,
        1,
        2
    ],
    "novel_classes": [
        3,
        4,
        5
    ],
    "total_classes": 6,
    "training_config": {
        "loss_function": "SupConLoss",
